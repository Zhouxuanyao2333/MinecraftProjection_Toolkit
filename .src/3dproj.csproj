<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Projection3D</AssemblyName>
    <RootNamespace>Projection3D</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ViewUI\GUIMainIMG\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- 打包形态开关：由 PackEmbedded.csproj 置 true 时，贴图编进程序集 -->
    <EmbedTextures Condition="'$(EmbedTextures)' == ''">false</EmbedTextures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- GUI 装饰素材：打进程序集，用 avares:// 加载 -->
    <AvaloniaResource Include="ViewUI\GUIMainIMG\**" />
  </ItemGroup>

  <!-- ============ 贴图：两种打包形态二选一 ============ -->
  <ItemGroup>
    <!-- 开发/普通发布：贴图目录随输出复制，运行时按磁盘路径读取 -->
    <None Remove="textures\**" Condition="'$(EmbedTextures)' == 'true'" />
    <None Include="textures\**" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(EmbedTextures)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(EmbedTextures)' == 'true'">
    <!-- 单文件发布：方块贴图编进程序集（1300 张 16×16 PNG，共约 0.33 MB） -->
    <EmbeddedResource Include="textures\block\*.png"
                      LogicalName="Projection3D.textures.block.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
